{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Backend Server",
      "type": "shell",
      "command": "npm run server",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "CiviCare API Server running",
          "endsPattern": "Core responder credentials"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "civicare"
      }
    },
    {
      "label": "Start Frontend Client",
      "type": "shell",
      "command": "npm run client",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE",
          "endsPattern": "Local:"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "civicare"
      }
    },
    {
      "label": "Run Both (Full Stack)",
      "dependsOn": [
        "Start Backend Server",
        "Start Frontend Client"
      ],
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
